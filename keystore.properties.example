# 发布签名配置模板 —— 复制成 keystore.properties 并填入真实值。
# keystore.properties 已在 .gitignore 中，绝不会被提交。
#
#     cp keystore.properties.example keystore.properties
#
# storeFile：绝对路径原样使用；相对路径以**仓库根目录**为基准解析
#            （CI 上 workflow 会把 keystore 写到仓库根，填 release.jks 即可）。
#
# ⚠️ keystore 与密码一旦丢失，就永远无法给已安装的老用户推送更新——
#    他们只能卸载重装。请离线备份：密码管理器 + 至少一处异地。

storeFile=/absolute/path/to/jev4bili-release.jks
storePassword=CHANGE_ME
keyAlias=jev4bili
keyPassword=CHANGE_ME

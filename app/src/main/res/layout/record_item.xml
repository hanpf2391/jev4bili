<?xml version="1.0" encoding="utf-8"?>
<!-- v0.9.8 记录单条卡（照设计稿视觉复刻）：圆点胶囊+百分比 | 标题 | 时间+∨ | 元信息(加粗项) | 底部置信度彩条 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rec_bg"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="9dp" android:paddingBottom="13dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/recPill"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:gravity="center"
                android:paddingStart="9dp" android:paddingEnd="9dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/pill_danger"
                android:text="● 营销号 94%" />

            <TextView
                android:id="@+id/recTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="标题" />

            <TextView
                android:id="@+id/recTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:text="00:00" />

            <TextView
                android:id="@+id/recChevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:text="∨" />
        </LinearLayout>

        <TextView
            android:id="@+id/recMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:text="UP主 · 元信息" />

        <TextView
            android:id="@+id/recDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:background="@drawable/pill_neutral"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="@color/fg2"
            android:visibility="gone"
            android:text="判定详情" />
    </LinearLayout>

    <!-- 底部置信度彩条（宽度=置信度%，颜色=判定色；代码设置宽度） -->
    <View
        android:id="@+id/recFill"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_gravity="bottom|start"
        android:background="@color/danger_red" />
</FrameLayout>
